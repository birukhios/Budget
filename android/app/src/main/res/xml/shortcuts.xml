<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon to reach setup again after the TWA takes over. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="et.birukfin.forwarder"
            android:targetClass="et.birukfin.forwarder.SetupActivity">
            <extra android:name="settings" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
